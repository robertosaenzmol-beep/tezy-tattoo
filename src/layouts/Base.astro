---
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo-black/400.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/caveat/600.css';
import '@fontsource/caveat/700.css';
import '../styles/global.css';
import { STUDIO } from '../data/site.js';

const { title = `${STUDIO.name} · Estudio de tatuaje en ${STUDIO.city}`, description = `Estudio de tatuaje y piercing en ${STUDIO.address}, ${STUDIO.city}. Cuéntanos tu idea y te responde directamente el artista.` } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TattooParlor',
  name: STUDIO.name,
  telephone: STUDIO.phone,
  address: { '@type': 'PostalAddress', streetAddress: STUDIO.address, postalCode: STUDIO.postal, addressLocality: STUDIO.city, addressRegion: 'Madrid', addressCountry: 'ES' },
};
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#222222">
  <link rel="icon" href="/favicon.jpg">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <slot />
</body>
</html>
